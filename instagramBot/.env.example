META_VERIFY_TOKEN=change-me-local-token
META_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
IG_USER_ID=
GRAPH_API_VERSION=v22.0

TELEGRAM_BOT_LINK=https://t.me/BOT_USERNAME?start=insta
TRIGGER_KEYWORDS=материал,материалы,ссылка,тест,урок,link
ALLOW_ANY_COMMENT=false

# Keep true until Meta app, webhook and permissions are ready.
DRY_RUN=true

# Local development fallback for Meta Dashboard test POSTs only.
# Keep false in production.
SKIP_SIGNATURE_VALIDATION=false

PUBLIC_COMMENT_REPLY_ENABLED=false
